---
/**
 * Singleton: shared "copy color" popover + toast. A click on any
 * [data-color-chip] opens a hex / utility / CSS-variable menu.
 */
---

<div class="menu-popup color-copy" popover id="color-copy-popover">
  <button class="menu-item copy-option" type="button" data-format="hex">
    <span class="color-copy-label">Hex</span>
    <code class="color-copy-value" data-target="hex"></code>
  </button>
  <button class="menu-item copy-option" type="button" data-format="class">
    <span class="color-copy-label">Tailwind</span>
    <code class="color-copy-value" data-target="class"></code>
  </button>
  <button class="menu-item copy-option" type="button" data-format="var">
    <span class="color-copy-label">Variable</span>
    <code class="color-copy-value" data-target="var"></code>
  </button>
</div>

<div class="copy-toast" id="color-copy-toast" role="status" aria-live="polite"></div>

<style>
  /* auto: the implicit anchor from showPopover({ source }), not .menu's --menu-trigger. */
  /* span-all centres on the chip and shifts inside the viewport; margin-inline is the edge gutter. */
  .color-copy[popover] {
    position-anchor: auto;
    position-area: block-end span-all;
    margin-inline: 0.5rem;
    max-width: 24rem;
  }
  .copy-option {
    justify-content: space-between;
    gap: 0.75rem;
  }
  .color-copy-label {
    flex: none;
    color: var(--color-text-muted);
  }
  .color-copy-value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.75rem;
    white-space: nowrap;
    background: transparent;
    padding: 0;
  }
  .copy-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.55rem 1rem;
    background: var(--color-text);
    color: var(--color-surface);
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 500;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    opacity: 0;
    transition: opacity 180ms ease;
    pointer-events: none;
    z-index: 100;
    white-space: nowrap;
  }
  .copy-toast.show {
    opacity: 1;
  }
</style>

<script>
  const popover = document.getElementById(
    "color-copy-popover",
  ) as HTMLDivElement | null;
  const toast = document.getElementById(
    "color-copy-toast",
  ) as HTMLDivElement | null;
  if (!popover || !toast) {
    /* nothing to wire up */
  } else {
    const slots = {
      hex: popover.querySelector('[data-target="hex"]') as HTMLElement,
      class: popover.querySelector('[data-target="class"]') as HTMLElement,
      var: popover.querySelector('[data-target="var"]') as HTMLElement,
    };

    let toastTimer: number | undefined;
    function flashToast(message: string) {
      toast!.textContent = message;
      toast!.classList.add("show");
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(
        () => toast!.classList.remove("show"),
        1400,
      );
    }

    const ctx = document
      .createElement("canvas")
      .getContext("2d", { willReadFrequently: true })!;
    // Paint opaque, then append alpha: getImageData unpremultiplies, so a low-alpha fill loses RGB precision.
    function toHex(value: string): string {
      const am = value.match(/(?:\/\s*|rgba\([^)]*,\s*)([\d.]+%?)\s*\)$/);
      const a = am
        ? am[1]!.endsWith("%")
          ? parseFloat(am[1]!) / 100
          : parseFloat(am[1]!)
        : 1;
      const opaque = value
        .replace(/\s*\/\s*[\d.]+%?\s*\)$/, ")")
        .replace(/^rgba\((.*),\s*[\d.]+\s*\)$/, "rgb($1)");
      ctx.clearRect(0, 0, 1, 1);
      ctx.fillStyle = "#000";
      ctx.fillStyle = opaque;
      ctx.fillRect(0, 0, 1, 1);
      const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
      const h = (n: number) => n.toString(16).padStart(2, "0");
      return `#${h(r!)}${h(g!)}${h(b!)}${a < 1 ? h(Math.round(a * 255)) : ""}`;
    }

    // The utility a reader would write: text- for foregrounds, border-/outline- for edges, bg- otherwise.
    function utility(variable: string): string {
      const key = variable.replace(/^--color-/, "");
      if (
        /^(text|link)\b|-(content|text)$/.test(key) ||
        /^category-[a-z]+$/.test(key)
      )
        return `text-${key}`;
      if (/^border\b/.test(key)) return `border-${key}`;
      if (key === "focus") return "outline-focus";
      return `bg-${key}`;
    }

    let activeAnchor: HTMLElement | null = null;

    function setAnchor(next: HTMLElement | null) {
      activeAnchor?.setAttribute("aria-expanded", "false");
      next?.setAttribute("aria-expanded", "true");
      activeAnchor = next;
    }

    // Light dismiss closes the popover on pointerup, before the click lands, even on its own source.
    let openOnPointerDown: HTMLElement | null = null;
    document.addEventListener(
      "pointerdown",
      () => {
        openOnPointerDown = popover.matches(":popover-open")
          ? activeAnchor
          : null;
      },
      { capture: true },
    );

    document.addEventListener("click", (event) => {
      const wasOpenFor = openOnPointerDown;
      openOnPointerDown = null;
      const trigger = (event.target as HTMLElement).closest(
        "[data-color-chip]",
      ) as HTMLElement | null;
      if (!trigger) return;

      const isOpen = popover.matches(":popover-open");
      if (
        (isOpen && activeAnchor === trigger) ||
        (event.detail > 0 && wasOpenFor === trigger)
      ) {
        if (isOpen) popover.hidePopover();
        return;
      }

      const variable = trigger.dataset.variable ?? "";
      const swatch = trigger.querySelector(
        "[data-color-swatch]",
      ) as HTMLElement | null;
      slots.hex.textContent = toHex(
        getComputedStyle(swatch ?? trigger).backgroundColor,
      );
      slots.class.textContent = utility(variable);
      slots.var.textContent = `var(${variable})`;

      // A bare popovertarget on a shared popover closes it on a second invoker instead of moving it.
      if (isOpen) popover.hidePopover();
      setAnchor(trigger);
      // TS's DOM lib predates the source option.
      (
        popover as HTMLElement & {
          showPopover(options: { source: HTMLElement }): void;
        }
      ).showPopover({ source: trigger });
    });

    // Toggle events coalesce, so a hide-then-show in one task arrives as open; only a real close clears.
    popover.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "closed") setAnchor(null);
    });

    popover.addEventListener("click", async (event) => {
      const option = (event.target as HTMLElement).closest(
        ".copy-option",
      ) as HTMLElement | null;
      if (!option) return;
      const format = option.dataset.format as "hex" | "class" | "var";
      const value = slots[format].textContent ?? "";
      const labels: Record<string, string> = {
        hex: "hex",
        class: "utility",
        var: "variable",
      };
      try {
        await navigator.clipboard.writeText(value);
        flashToast(`Copied ${labels[format]} ${value}`);
      } catch {
        flashToast("Copy failed");
      }
      popover.hidePopover();
    });
  }
</script>
