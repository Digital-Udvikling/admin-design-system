---
// A highlighted `.code-block` with a copy button.
import { Code } from "astro:components";
import type { HTMLAttributes } from "astro/types";
import { shikiTheme } from "../shiki-theme";

interface Props extends HTMLAttributes<"div"> {
  code: string;
  lang: "html" | "tsx" | "bash" | "css";
}

const { code, lang, class: className, ...rest } = Astro.props;
---

<div class:list={["not-content", "code-pane", className]} {...rest}>
  <Code
    code={code}
    lang={lang}
    theme={shikiTheme}
    wrap={null}
    class="code-block code-block-nowrap"
  />
  <button type="button" class="btn btn-ghost btn-sm btn-square code-pane-copy" aria-label="Copy code">
    <i class="ti ti-copy" aria-hidden="true"></i>
    <i class="ti ti-check" aria-hidden="true"></i>
  </button>
  <span class="code-pane-status" role="status"></span>
</div>

<script>
  // One delegated listener per page: the clipboard has no declarative equivalent.
  document.addEventListener("click", async (event) => {
    const button = event.target instanceof Element ? event.target.closest(".code-pane-copy") : null;
    const pane = button?.closest(".code-pane");
    if (!button || !pane) return;
    await navigator.clipboard.writeText(pane.querySelector("pre")?.textContent ?? "");
    const status = pane.querySelector(".code-pane-status");
    button.setAttribute("data-copied", "");
    if (status) status.textContent = "Copied";
    setTimeout(() => {
      button.removeAttribute("data-copied");
      if (status) status.textContent = "";
    }, 1200);
  });
</script>

<style>
  .code-pane {
    position: relative;
  }
  /* Room for the copy button over the first line. */
  .code-pane :global(.code-block) {
    padding-inline-end: 2.75rem;
  }
  .code-pane-copy {
    position: absolute;
    top: 0.375rem;
    inset-inline-end: 0.375rem;
  }
  .code-pane-copy:not([data-copied]) .ti-check,
  .code-pane-copy[data-copied] .ti-copy {
    display: none;
  }
  .code-pane-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
