---
// The page chrome, built from the design system's own vanilla classes: app shell,
// sticky navbar, sidebar (copied into a drawer below 64rem), reading-size `.prose` article, TOC
// and previous/next links.
import "../styles/global.css";
// Source, not the package export: the scoped plugin wraps Tailwind's output.
import "../../../../packages/admin-css/src/admin.css?scoped";
// Kept out of the HMR'd sheets: re-parsing @font-face on every CSS edit
// re-registers the fonts and flashes fallback text and icons.
import "@aortl/admin-css/fonts.css";
import "@tabler/icons-webfont/dist/tabler-icons.min.css";
import tablerIcons from "@tabler/icons-webfont/dist/fonts/tabler-icons.woff2?url";
import tabler from "@tabler/icons-webfont/package.json";
import plexMono from "../../../../packages/admin-css/src/fonts/plex-mono-400-latin.woff2?url";
import plexSans from "../../../../packages/admin-css/src/fonts/plex-sans-latin.woff2?url";
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import DocsPalette, { type PageLink } from "../components/DocsPalette";
import FlavorPicker from "../components/FlavorPicker.astro";
import SidebarNav from "../components/SidebarNav.astro";
import ThemeSelect from "../components/ThemeSelect.astro";
import { buildNav, entryPath, flatNav } from "../nav";
import { version } from "../version";

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  /** Deepest heading level the TOC lists. */
  tocDepth?: number;
  /** Source path under apps/docs, for the "Edit page" link. */
  editPath?: string;
  /** Whether site search indexes the page. */
  searchable?: boolean;
}

const {
  title,
  description,
  headings = [],
  tocDepth = 3,
  editPath,
  searchable = true,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const site = "Admin design system";
const repo = "https://github.com/Digital-Udvikling/admin-design-system";
const entries = await getCollection("docs");
const nav = buildNav(entries, base);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= tocDepth);
// A one-entry TOC only repeats the page's single section.
const showToc = toc.length > 1;
const isHome = Astro.url.pathname === base;
const sequence = flatNav(nav);
const at = sequence.findIndex((l) => l.href === Astro.url.pathname);
const prev = at > 0 ? sequence[at - 1] : undefined;
const next = at >= 0 ? sequence[at + 1] : undefined;
const descriptions = new Map(entries.map((e) => [`${base}${entryPath(e)}`, e.data.description]));
const pages: PageLink[] = nav.flatMap((group) =>
  group.items
    .flatMap((item) => ("links" in item ? item.links : [item]))
    .map((l) => ({
      title: l.title ?? l.label,
      href: l.href,
      description: descriptions.get(l.href),
      section: group.label,
    })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{isHome ? site : `${title} | ${site}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {/* Fonts are otherwise requested only once layout needs them, too late for the first
    paint even from cache. Each href must match the stylesheet's URL exactly, query included. */}
    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href={`${tablerIcons}?v${tabler.version}`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site} />
    <script is:inline>
      try {
        const theme = localStorage.getItem("admin-docs-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="btn btn-primary btn-sm docs-skip" href="#content">Skip to content</a>
    <div class="app-shell app-shell-sticky docs-shell">
      <header class="navbar">
        <button
          class="navbar-mobile-toggle"
          type="button"
          aria-label="Open menu"
          commandfor="nav-drawer"
          command="show-modal"></button>
        <a class="navbar-brand docs-brand" href={base}>
          <span class="docs-brand-full">{site}</span>
          <span class="docs-brand-short">Admin DS</span>
        </a>
        <a class="badge docs-version" href={`${base}changelog/`}>v{version}</a>
        <div class="navbar-actions">
          <button
            type="button"
            class="palette-trigger docs-search"
            data-admin-palette
            aria-haspopup="dialog"
            aria-label="Search"
            aria-keyshortcuts="Control+K Meta+K /">
            <i class="ti ti-search" aria-hidden="true"></i>
            <span class="palette-trigger-label">Search</span>
            <span class="kbd-group" aria-hidden="true">
              <kbd class="kbd docs-search-mod">Ctrl</kbd><kbd class="kbd">K</kbd>
            </span>
          </button>
          <script is:inline>
            // The hint shows ⌘ where that is the modifier.
            (() => {
              const platform = navigator.userAgentData?.platform || navigator.platform;
              if (!/mac|iphone|ipad/i.test(platform)) return;
              for (const key of document.querySelectorAll(".docs-search-mod")) key.textContent = "⌘";
            })();
          </script>
          <FlavorPicker />
          <ThemeSelect />
          <a class="btn btn-ghost btn-sm btn-square" href={repo} aria-label="GitHub">
            <i class="ti ti-brand-github" aria-hidden="true"></i>
          </a>
        </div>
      </header>
      <aside class="sidebar">
        <SidebarNav groups={nav} current={Astro.url.pathname} />
      </aside>
      <script is:inline>
        // Right after the sidebar, so it runs before the first paint: bring the current
        // page's link into view in a long sidebar, without scrolling the page.
        (() => {
          const nav = document.querySelector(".app-shell > .sidebar .sidebar-nav");
          const link = nav?.querySelector('[aria-current="page"]');
          if (!nav || !link) return;
          const offset = link.getBoundingClientRect().top - nav.getBoundingClientRect().top;
          if (offset > nav.clientHeight - 48) nav.scrollTop = offset - nav.clientHeight / 2;
        })();
      </script>
      <main class="docs-main" id="content">
        <div class="container docs-page">
          {/* Pagefind indexes only the article; data-pagefind-ignore drops the parts that repeat it. */}
          <article class="prose prose-lg docs-article" data-pagefind-body={searchable ? "" : undefined}>
            <h1>{title}</h1>
            {!isHome && description && <p class="docs-lede">{description}</p>}
            {
              showToc && (
                <details class="accordion-item prose-exclude docs-toc-mobile" data-pagefind-ignore>
                  <summary class="accordion-summary">On this page</summary>
                  <nav class="accordion-content" aria-label="On this page">
                    <ul class="docs-toc-list">
                      {toc.map((h) => (
                        <li data-depth={h.depth}>
                          <a href={`#${h.slug}`}>{h.text}</a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                </details>
              )
            }
            <slot />
            {
              editPath && (
                <p class="docs-edit" data-pagefind-ignore>
                  <a class="link" href={`${repo}/edit/main/apps/docs/${editPath}`}>
                    <i class="ti ti-pencil" aria-hidden="true" />
                    Edit page
                  </a>
                </p>
              )
            }
            {
              (prev || next) && (
                <nav class="docs-pager prose-exclude" aria-label="Previous and next page" data-pagefind-ignore>
                  {prev && (
                    <a class="card card-bordered card-compact docs-pager-link" rel="prev" href={prev.href}>
                      <div class="card-body">
                        <div class="card-description">Previous</div>
                        <div class="card-title">{prev.label}</div>
                      </div>
                    </a>
                  )}
                  {next && (
                    <a class="card card-bordered card-compact docs-pager-link" rel="next" href={next.href}>
                      <div class="card-body">
                        <div class="card-description">Next</div>
                        <div class="card-title">{next.label}</div>
                      </div>
                    </a>
                  )}
                </nav>
              )
            }
          </article>
          {
            showToc && (
              <nav class="docs-toc" aria-labelledby="toc-heading">
                <div class="docs-toc-heading" id="toc-heading">On this page</div>
                <ul class="docs-toc-list">
                  {toc.map((h) => (
                    <li data-depth={h.depth}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </main>
    </div>
    <dialog id="nav-drawer" class="dialog drawer drawer-start" closedby="any" aria-label="Navigation">
      <aside class="sidebar">
        <div class="sidebar-header">
          {/* The drawer is wide enough for the full name; a bare span gets the system ellipsis. */}
          <a class="navbar-brand docs-brand" href={base}><span>{site}</span></a>
          <button
            type="button"
            class="dialog-close"
            commandfor="nav-drawer"
            command="close"
            aria-label="Close menu"><i class="ti ti-x" aria-hidden="true"></i></button>
        </div>
        <SidebarNav groups={nav} current={Astro.url.pathname} autofocusCurrent />
        <div class="sidebar-footer">
          <a class="sidebar-item" href={repo}>
            <i class="ti ti-brand-github sidebar-icon" aria-hidden="true"></i>
            <span class="sidebar-label">GitHub</span>
            <span class="sidebar-badge">v{version}</span>
          </a>
          <label class="sidebar-item docs-drawer-theme">
            <i class="ti ti-sun-moon sidebar-icon" aria-hidden="true"></i>
            <span class="sidebar-label">Theme</span>
            <ThemeSelect />
          </label>
        </div>
      </aside>
    </dialog>
    <DocsPalette client:idle pages={pages} base={base} />
  </body>
</html>
