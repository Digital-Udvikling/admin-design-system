---
import { CALLOUT_LABELS } from "./callout-labels.mjs";

// A soft `.alert` at the article's reading size. `prose-exclude` keeps `.prose` element
// rules off the body, so its markdown links and code get the styles below.
interface Props {
  /** Tone of the tint, border and icon. */
  variant?: "info" | "success" | "warning" | "danger";
}

const { variant = "warning" } = Astro.props;

const ICONS = {
  info: "ti-info-circle",
  success: "ti-circle-check",
  warning: "ti-alert-triangle",
  danger: "ti-alert-octagon",
};
---

<div class:list={["alert", `alert-${variant}`, "alert-soft", "prose-exclude", "callout"]}>
  <i class={`ti ${ICONS[variant]}`} aria-hidden="true"></i>
  <div class="callout-body">
    <span class="sr-only">{CALLOUT_LABELS[variant]}:</span>
    <slot />
  </div>
</div>

<style>
  .callout {
    font-size: 1rem;
    line-height: 1.6;
  }

  /* `.alert` centres the glyph on a 1.25rem first line; this one is 1.6rem. */
  .callout > i {
    margin-block-start: calc((1.6rem - 1lh) / 2);
  }

  .callout-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .callout-body :global(p) {
    margin: 0;
  }

  /* The `.code` chip; markdown can't add the class. */
  .callout-body :global(:not(pre) > code) {
    padding: 0.125em 0.3em;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    background-color: color-mix(in srgb, currentColor 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  /* The `.link` look a soft alert keeps; markdown can't add the class. */
  .callout-body :global(a:not(.btn)) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
    border-radius: 0.25rem;
  }
  .callout-body :global(a:not(.btn):hover) {
    color: var(--color-link-hover);
  }
  .callout-body :global(a:not(.btn):focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
