---
import CodePane from "../../src/components/CodePane.astro";

interface Props {
  /** Pre-formatted HTML source. */
  html?: string;
  /** Pre-formatted React source. */
  react?: string;
}

const { html, react } = Astro.props;
const hasReact = !!react;
const hasBoth = !!html && hasReact;
---

{/* A dual example shows the flavor picked by the page's `#flavor-*` radios (FlavorPicker.astro). */}
<section class="not-content example-block" data-dual={hasBoth ? "" : undefined}>
  <div class="example-frame">
    {
      hasBoth ? (
        <div class="example-preview">
          <div class="preview-variant" data-variant="html" set:html={html!} />
          <div class="preview-variant" data-variant="react">
            <slot name="preview" />
          </div>
        </div>
      ) : (
        <div class="example-preview">
          {hasReact ? (
            <slot name="preview" />
          ) : html ? (
            <Fragment set:html={html} />
          ) : null}
        </div>
      )
    }
    <div class="example-source">
      {html && <CodePane code={html} lang="html" data-variant="html" />}
      {react && <CodePane code={react} lang="tsx" data-variant="react" />}
    </div>
  </div>
</section>

<style>
  .example-block {
    margin: 1.5rem 0 2rem;
  }
  .example-frame {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-surface);
  }
  /* Stand-ins for admin-css/base.css, which the docs skip so Starlight keeps its body. */
  .example-preview {
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text);
  }
  /* The frame's `overflow: hidden` (needed for rounded corners) clips vanilla
  `.tooltip-wrap` tooltips — pad enough to contain one on any side. */
  .example-preview:has(.tooltip-wrap) {
    padding: 3rem;
  }
  /* Layout-transparent so children flex directly in the preview; the explicit
  [hidden] rule must outrank display: contents. */
  .example-preview .preview-variant {
    display: contents;
  }
  .example-preview .preview-variant[hidden] {
    display: none;
  }
  .example-source :global(.code-block) {
    margin: 0;
    border-radius: 0;
  }
  /* Global: the flavor radios live in the page chrome, and `data-variant` also
  marks CodePane roots, which this component's scope doesn't reach. */
  :global(:root:has(#flavor-html:checked) .example-block[data-dual] [data-variant="react"]),
  :global(:root:has(#flavor-react:checked) .example-block[data-dual] [data-variant="html"]) {
    display: none;
  }
</style>
