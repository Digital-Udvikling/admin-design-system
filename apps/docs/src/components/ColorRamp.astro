---
interface Tone {
  label: string;
  variable: string;
}

interface Props {
  family: string;
  tones: Tone[];
}

const { family, tones } = Astro.props;
---

<section class="prose-exclude ramp">
  <h3 class="ramp-title">{family}</h3>
  <ol class="ramp-strip" style={`--ramp-count: ${tones.length}`}>
    {
      tones.map((t) => (
        <li class="ramp-step">
          <button
            type="button"
            class="ramp-trigger"
            data-color-chip
            data-variable={t.variable}
            aria-label={`Copy ${family} ${t.label} (${t.variable})`}
            aria-expanded="false"
            aria-controls="color-copy-popover"
          >
            <span
              class="ramp-chip"
              data-color-swatch
              style={`background: var(${t.variable})`}
              aria-hidden="true"
            />
            <span class="ramp-label">{t.label}</span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .ramp {
    container-type: inline-size;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }
  .ramp:first-of-type {
    border-top: none;
    padding-top: 0.25rem;
  }
  .ramp-title {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .ramp-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--ramp-count), minmax(0, 1fr));
    gap: 0.25rem;
  }
  .ramp-step {
    min-width: 0;
  }
  .ramp-trigger {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    text-align: center;
    cursor: pointer;
    font: inherit;
    color: inherit;
    border-radius: 0.3rem;
  }
  .ramp-trigger:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .ramp-chip {
    display: block;
    aspect-ratio: 1;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    transition: transform 120ms ease;
  }
  .ramp-trigger:hover .ramp-chip {
    transform: translateY(-1px);
  }
  .ramp-label {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    line-height: 1;
    white-space: nowrap;
  }
  /* Below 36rem a 12px "paper" overflows a 16-column cell. */
  @container (width < 36rem) {
    .ramp-strip {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      row-gap: 0.5rem;
    }
  }
  @media (forced-colors: active) {
    /* swatch colour is the content */
    .ramp-chip {
      forced-color-adjust: none;
      border-color: CanvasText;
    }
  }
</style>
