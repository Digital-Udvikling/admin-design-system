---
interface Variant {
  label: string;
  variable: string;
}

interface Props {
  family: string;
  description?: string;
  variants: Variant[];
}

const { family, description, variants } = Astro.props;
---

<section class="prose-exclude family">
  <header class="family-head">
    <h3 class="family-title">{family}</h3>
    {description && <p class="family-desc">{description}</p>}
  </header>
  <ul class="family-strip">
    {
      variants.map((v) => (
        <li class="variant">
          <button
            type="button"
            class="variant-trigger"
            data-color-chip
            data-variable={v.variable}
            aria-label={`Copy ${v.label} (${v.variable})`}
            aria-expanded="false"
            aria-controls="color-copy-popover"
          >
            <span
              class="variant-chip"
              data-color-swatch
              style={`background: var(${v.variable})`}
              aria-hidden="true"
            />
            <span class="variant-meta">
              <span class="variant-label">{v.label}</span>
              <code class="variant-var">{v.variable}</code>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .family {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--color-border);
  }
  .family:first-of-type {
    border-top: none;
    padding-top: 0.5rem;
  }
  .family-head {
    max-width: 45em;
  }
  .family-title {
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  .family-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.45;
  }
  .family-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* Half the strip less half the gap, so narrow phones keep two columns. */
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, calc(50% - 0.375rem)), 1fr));
    gap: 0.75rem;
  }
  .variant {
    min-width: 0;
  }
  .variant-trigger {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    padding: 0;
    background: transparent;
    border: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    border-radius: 0.5rem;
  }
  .variant-trigger:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .variant-chip {
    display: block;
    height: 3.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
    transition: transform 120ms ease;
  }
  .variant-trigger:hover .variant-chip {
    transform: translateY(-1px);
  }
  .variant-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .variant-label {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .variant-var {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: transparent;
    padding: 0;
  }
  @media (forced-colors: active) {
    /* swatch colour is the content */
    .variant-chip {
      forced-color-adjust: none;
      border-color: CanvasText;
      box-shadow: none;
    }
  }
</style>
