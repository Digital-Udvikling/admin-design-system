---
// A highlighted `.code-block` with a copy button.
import { Code } from "astro:components";
import type { HTMLAttributes } from "astro/types";
import { shikiTheme } from "../shiki-theme";
import CodeCopy from "./CodeCopy.astro";

interface Props extends HTMLAttributes<"div"> {
  code: string;
  lang: "html" | "tsx" | "bash" | "css";
}

const { code, lang, class: className, ...rest } = Astro.props;
---

<div class:list={["prose-exclude", "code-pane", className]} {...rest}>
  <Code code={code} lang={lang} theme={shikiTheme} wrap={null} class="code-block code-block-nowrap" />
  <CodeCopy />
</div>
