---
// A highlighted `.code-block` under a bar with its language and a copy button.
import { Code } from "astro:components";
import type { HTMLAttributes } from "astro/types";
import { shikiTheme } from "../shiki-theme";
import CodeBar from "./CodeBar.astro";

interface Props extends HTMLAttributes<"div"> {
  code: string;
  lang: "html" | "tsx" | "bash" | "css";
  /** Bar label instead of the language name. */
  label?: string;
}

const { code, lang, label, class: className, ...rest } = Astro.props;
---

<div class:list={["prose-exclude", "code-pane", className]} {...rest}>
  <CodeBar lang={lang} label={label} />
  <Code code={code} lang={lang} theme={shikiTheme} wrap={null} class="code-block code-block-nowrap" />
</div>
